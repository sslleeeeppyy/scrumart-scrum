<%- include('partials/header') %>

<h1>Главная</h1>
<p class="lead"><%= product.description %></p>
<p class="version">Версия <%= product.version %></p>

<section class="stats">
  <div class="stat">
    <span class="stat-label">Спринт <%= sprint.number %></span>
    <span class="stat-value"><%= sprint.goal %></span>
    <span class="stat-note"><%= fmtDate(sprint.start) %> — <%= fmtDate(sprint.end) %></span>
  </div>
  <div class="stat">
    <span class="stat-label">Загрузка спринта</span>
    <span class="stat-value"><%= sprint.load %> из <%= sprint.capacity %> SP</span>
    <span class="stat-note">выполнено <%= sprint.done %> SP</span>
  </div>
  <div class="stat">
    <span class="stat-label">Бэклог</span>
    <span class="stat-value"><%= backlogCount %> задач</span>
    <span class="stat-note">ждут планирования</span>
  </div>
</section>

<h2>Что можно сделать</h2>
<ul class="actions">
  <li><a href="/tasks/new">Добавить задачу в бэклог</a> — название, исполнитель, оценка в story points, приоритет.</li>
  <li><a href="/backlog">Посмотреть бэклог</a> и перенести задачу в текущий спринт.</li>
  <li><a href="/sprint">Открыть Scrum-доску</a> спринта <%= sprint.number %> и передвинуть задачу по колонкам.</li>
  <li><a href="/sprint-overload">Посмотреть отказ</a>: задача не помещается в спринт, потому что превышена ёмкость команды.</li>
</ul>

<%- include('partials/footer') %>
