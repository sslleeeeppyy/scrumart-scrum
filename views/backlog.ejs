<%- include('partials/header') %>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
  <div>
    <h1 class="h3 mb-1">Бэклог проекта</h1>
    <div class="text-secondary small">В спринте <%= sprint.number %> занято <b><%= sprint.load %> из <%= sprint.capacity %> SP</b> · ёмкость спринта — velocity команды</div>
  </div>
  <a class="btn btn-primary" href="/tasks/new"><i class="bi bi-plus-lg me-1"></i>Добавить задачу</a>
</div>

<% if (createdTask) { %>
  <div class="alert alert-success d-flex align-items-center gap-2" role="status">
    <i class="bi bi-check-circle-fill"></i>
    <div>Задача «<%= createdTask.title %>» добавлена в бэклог и сохранена в базе.</div>
  </div>
<% } %>

<div class="card border-0 shadow-sm">
<% if (tasks.length === 0) { %>
  <div class="empty-state">
    <i class="bi bi-inbox"></i>
    <h2 class="h5 mt-3">Бэклог пока пуст</h2>
    <p class="text-secondary mb-3">Добавьте первую задачу проекта: съёмку, монтаж, цветокоррекцию.<br>Потом её можно будет перенести в спринт <%= sprint.number %>.</p>
    <a class="btn btn-primary" href="/tasks/new"><i class="bi bi-plus-lg me-1"></i>Создать первую задачу</a>
  </div>
<% } else { %>
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
        <tr><th class="ps-3">№</th><th>Задача</th><th>Исполнитель</th><th class="text-center">SP</th><th>Приоритет</th><th class="text-end pe-3"></th></tr>
      </thead>
      <tbody>
      <% tasks.forEach((t) => { %>
        <tr class="<%= t.id === created ? 'table-success' : '' %>">
          <td class="ps-3 text-secondary"><%= t.id %></td>
          <td class="fw-medium"><%= t.title %></td>
          <td><% if (t.assigneeRole) { %><%= t.assignee %> <span class="text-secondary small">· <%= t.assigneeRole.toLowerCase() %></span><% } else { %><span class="text-secondary">Не назначен</span><% } %></td>
          <td class="text-center"><span class="badge rounded-pill text-bg-primary sp-badge"><%= t.storyPoints %></span></td>
          <td><span class="badge <%= ['text-bg-danger', 'text-bg-warning', 'text-bg-secondary'][PRIORITIES.indexOf(t.priority)] %>"><%= t.priority %></span></td>
          <td class="text-end pe-3">
            <form method="post" action="/backlog/<%= t.id %>/to-sprint" class="m-0">
              <button class="btn btn-sm btn-outline-primary" type="submit"><i class="bi bi-arrow-right-circle me-1"></i>В спринт <%= sprint.number %></button>
            </form>
          </td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
<% } %>
</div>

<%- include('partials/footer') %>
